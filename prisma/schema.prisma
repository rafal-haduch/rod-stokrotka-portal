generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
    ADMIN
    PRESIDENT
    DEPUTY_PRESIDENT
    SECRETARY
    TREASURER
    BOARD_MEMBER
    ALLOTMENT_GARDENER
}

model User {
    id       Int    @id @default(autoincrement())
    login    String @unique
    password String
    name     String
    plots    Plot[]
    role     Role   @default(ALLOTMENT_GARDENER)

    createdAt  DateTime  @default(now()) @map("created_at")
    firstLogin Boolean   @default(true)
    updatedAt  DateTime  @updatedAt @map("updated_at")
    lastLogin  DateTime?

    createdAnnouncements Announcement[] @relation("AnnouncementAuthor")
    updatedAnnouncements Announcement[] @relation("AnnouncementUpdater")
    deletedAnnouncements Announcement[] @relation("AnnouncementDeleter")
}

model Plot {
    id         Int    @id @default(autoincrement())
    plotNumber String @unique @map("plot_number") @db.VarChar(10)
    area       Float?

    ownerId Int?  @map("owner_id")
    owner   User? @relation(fields: [ownerId], references: [id])

    payments Payment[]
}

model Payment {
    id Int @id @default(autoincrement())

    plot   Plot @relation(fields: [plotId], references: [id])
    plotId Int  @map("plot_id")

    year Int
    paid Boolean @default(false)

    plotAreaFee    Float  @map("plot_area_fee")
    wasteFee       Float  @map("waste_fee")
    membershipFee  Float  @map("membership_fee")
    electricityFee Float? @map("electricity_fee")
    totalAmount    Float  @map("total_amount")
}

model Announcement {
    id      Int    @id @default(autoincrement())
    title   String
    content String

    createdAt DateTime @default(now()) @map("created_at")

    author   User @relation("AnnouncementAuthor", fields: [authorId], references: [id])
    authorId Int  @map("author_id")

    updatedAt DateTime @updatedAt @map("updated_at")

    updatedBy   User? @relation("AnnouncementUpdater", fields: [updatedById], references: [id])
    updatedById Int?  @map("updated_by_id")

    deletedAt DateTime? @map("deleted_at")

    deletedBy   User? @relation("AnnouncementDeleter", fields: [deletedById], references: [id])
    deletedById Int?  @map("deleted_by_id")
}
