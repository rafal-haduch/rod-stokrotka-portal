generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
    ADMIN
    PRESIDENT
    DEPUTY_PRESIDENT
    SECRETARY
    TREASURER
    BOARD_MEMBER
    ALLOTMENT_GARDENER
}

model User {
    id            String         @id @default(cuid())
    login         String         @unique
    password      String
    name          String
    role          Role           @default(ALLOTMENT_GARDENER)
    plots         Plot[]
    createdAt     DateTime       @default(now())
    announcements Announcement[]
}

model Plot {
    id       String    @id @default(cuid())
    number   String
    area     Float
    owner    User      @relation(fields: [ownerId], references: [id])
    ownerId  String
    payments Payment[]
}

model Payment {
    id     String  @id @default(cuid())
    amount Float
    year   Int
    paid   Boolean @default(false)
    plot   Plot    @relation(fields: [plotId], references: [id])
    plotId String
}

model Announcement {
    id            String   @id @default(cuid())
    title         String
    content       String
    createdAt     DateTime @default(now())
    postCreator   User     @relation(fields: [postCreatorId], references: [id])
    postCreatorId String
}
