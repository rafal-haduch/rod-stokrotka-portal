generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum UserRole {
    ADMIN
    PRESIDENT
    DEPUTY_PRESIDENT
    SECRETARY
    TREASURER
    BOARD_MEMBER
    ALLOTMENT_GARDENER
}

enum PlotRole {
    CO_OWNER
    USER
}

enum PaymentMethod {
    CASH
    BANK_TRANSFER
}

enum Action {
    CREATE
    UPDATE
    DELETE
}

enum Entity {
    USER
    PLOT
    USER_PLOT
    FEE
    PAYMENT
    ANNOUNCEMENT
}

model User {
    id              Int       @id @default(autoincrement())
    name            String
    role            UserRole  @default(ALLOTMENT_GARDENER)
    login           String    @unique
    passwordHash    String    @map("password_hash")
    lastLogin       DateTime? @map("last_login")
    createdAt       DateTime  @default(now()) @map("created_at")
    updatedAt       DateTime? @map("updated_at")
    deletedAt       DateTime? @map("deleted_at")
    deletedByUserId Int?      @map("deleted_by_user_id")

    ownedPlots      Plot[]     @relation("PlotOwner")
    plotMemberships UserPlot[]

    @@map("users")
}

model Plot {
    id              Int       @id @default(autoincrement())
    number          String    @unique @db.VarChar(10)
    area            Decimal?  @db.Decimal(6, 2)
    ownerId         Int?      @map("owner_id")
    createdAt       DateTime  @default(now()) @map("created_at")
    updatedAt       DateTime  @updatedAt @map("updated_at")
    deletedAt       DateTime? @map("deleted_at")
    deletedByUserId Int?      @map("deleted_by_user_id")

    owner   User?      @relation("PlotOwner", fields: [ownerId], references: [id])
    members UserPlot[]
    fees    Fee[]

    @@index([ownerId])
    @@map("plots")
}

//TODO: add id?
model UserPlot {
    userId Int      @map("user_id")
    plotId Int      @map("plot_id")
    role   PlotRole

    user User @relation(fields: [userId], references: [id])
    plot Plot @relation(fields: [plotId], references: [id])

    @@id([userId, plotId])
    @@index([plotId])
    @@map("user_plots")
}

model Fee {
    id              Int       @id @default(autoincrement())
    plotId          Int       @map("plot_id")
    year            Int
    paid            Boolean   @default(false)
    plotAreaFee     Decimal   @map("plot_area_fee") @db.Decimal(10, 2)
    wasteFee        Decimal   @map("waste_fee") @db.Decimal(10, 2)
    membershipFee   Decimal   @map("membership_fee") @db.Decimal(10, 2)
    electricityFee  Decimal?  @map("electricity_fee") @db.Decimal(10, 2)
    createdAt       DateTime  @default(now()) @map("created_at")
    updatedAt       DateTime  @updatedAt @map("updated_at")
    deletedAt       DateTime? @map("deleted_at")
    deletedByUserId Int?      @map("deleted_by_user_id")

    plot    Plot     @relation(fields: [plotId], references: [id])
    payment Payment?

    @@unique([plotId, year])
    @@index([plotId])
    @@index([year])
    @@map("fees")
}

model Payment {
    id                 Int           @id @default(autoincrement())
    feeId              Int           @unique @map("fee_id")
    paidAt             DateTime      @default(now()) @map("paid_at")
    method             PaymentMethod
    receivedByUserId   Int           @map("received_by_user_id")
    receivedByUserName String        @map("received_by_user_name")
    deletedAt          DateTime?     @map("deleted_at")
    deletedByUserId    Int?          @map("deleted_by_user_id")

    fee Fee @relation(fields: [feeId], references: [id])

    @@index([receivedByUserId])
    @@map("payments")
}

model Announcement {
    id         Int      @id @default(autoincrement())
    title      String
    content    String
    createdAt  DateTime @default(now()) @map("created_at")
    authorId   Int      @map("author_id")
    authorName String   @map("author_name")

    updatedAt       DateTime  @updatedAt @map("updated_at")
    deletedAt       DateTime? @map("deleted_at")
    deletedByUserId Int?      @map("deleted_by_user_id")

    @@index([authorId])
    @@index([createdAt])
    @@map("announcements")
}

model AuditLog {
    id          Int      @id @default(autoincrement())
    action      Action
    entity      Entity
    entityId    Int      @map("entity_id")
    userId      Int      @map("user_id")
    userName    String   @map("user_name")
    createdAt   DateTime @default(now()) @map("created_at")
    //NOTE: State is saved only while update action.
    stateBefore Json?    @map("state_before")
    stateAfter  Json?    @map("state_after")

    @@index([userId])
    @@index([entity, entityId])
    @@index([createdAt])
    @@map("audit_logs")
}
