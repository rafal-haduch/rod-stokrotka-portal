# For prisma in file .env
DATABASE_URL=

# Seasonal theme radio visibility (boolean)
NEXT_PUBLIC_SHOW_SEASONAL_THEME=

# Gmail association account for sending messages
MAIL_ASSOCIATION=

# App password for the Gmail association account
MAIL_PASS=

# Disable TLS verification, local use only! (value = 0)
NODE_TLS_REJECT_UNAUTHORIZED=

# Secret for NextAuth
NEXTAUTH_SECRET=

# URL for NextAuth
NEXTAUTH_URL=
